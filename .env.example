# Server-only. Never commit a real key.
STRIPE_SECRET_KEY=sk_test_replace_me

# Not used by hosted Checkout. Never commit a real key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Signing secret for POST /api/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.async_payment_failed
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Existing Closepath price on the Anzen Digital Media Stripe account.
# One-time, usd, unit_amount 5900 ($59). Product: prod_Va7nrCPUNongqM
# Checkout uses this price. Do not create another Closepath product or price.
STRIPE_PRICE_ID=price_1UYxYNII1hyfpOcH1NWbxwsw

# Signs the Closepath sign-in cookie (HMAC-SHA256). Required on the Netlify site
# or a buyer who paid cannot set a password or come back to their book.
# Generate with: openssl rand -base64 32
# Rotating it signs everyone out. Never commit a real value.
CLOSEPATH_SESSION_SECRET=

# Buyer books are stored in Netlify Blobs on this same site (store name: closepath).
# The deployed site already has that store. No new database account.
# `next dev` keeps books in .data/closepath instead (gitignored).
# Optional, only to point local dev at the live blob store:
# NETLIFY_SITE_ID=
# NETLIFY_AUTH_TOKEN=
